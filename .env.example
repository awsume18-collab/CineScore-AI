# Cinescore environment variables
# Copy to .env and adjust as needed.

# ── Device ──
CINESCORE_DEVICE=cuda

# ── Model names ──
CINESCORE_CLIP_MODEL=ViT-B-32
CINESCORE_CLIP_PRETRAINED=laion2b_s34b_b79k
CINESCORE_BLIP_MODEL=Salesforce/blip2-opt-2.7b
CINESCORE_MUSICGEN_MODEL=facebook/musicgen-small

# ── Generation ──
CINESCORE_GUIDANCE_SCALE=3.0
CINESCORE_TOP_K=250
CINESCORE_TEMPERATURE=1.0
CINESCORE_DEFAULT_DURATION_S=30
CINESCORE_MAX_DURATION_S=90

# ── Thresholds ──
CINESCORE_MIN_AXIS_CONFIDENCE=0.15
CINESCORE_DEGENERATE_THRESHOLD=0.10

# ── Post-processing ──
CINESCORE_ENFORCE_TEMPO=false
CINESCORE_TARGET_LUFS=-14.0
CINESCORE_FADE_MS=200

# ── Paths ──
CINESCORE_OUTPUT_DIR=outputs
